# =========================================================================
# Ansys Lumerical Script (.lsf)
# 3D Geometry Generation for InP Waveguide with Two-Stage Symmetric Tapers
# Based on Slide 1 of 20261105_measurement_structure.pptx
#
# Coordinate System (modified to match Lumerical's coordinate system):
#   x : Propagation / longitudinal direction
#   y : Lateral / width direction (in-plane)
#   z : Vertical / thickness direction (out-of-plane)
# =========================================================================

clear;
deleteall;

# -------------------------------------------------------------------------
# 1. Geometry Parameters (SI units: meters)
# -------------------------------------------------------------------------
um = 1e-6;
nm = 1e-9;

# Longitudinal lengths (x-direction)
L_taper1 = 190 * um;   # Outer taper length (left & right)
L_taper2 = 10 * um;    # Inner taper length (left & right)
L_center = 200 * um;   # Central straight section length

# Lateral widths (y-direction)
w_tip    = 0.1 * um;   # Outer tip width at ends
w_mid    = 0.5 * um;   # Intermediate width between outer and inner tapers
w_core   = 1.5 * um;   # Central waveguide width

# Vertical thickness (z-direction)
t_z      = 250 * nm;   # InP layer thickness (0.25 um)
z_center = 0.0;        # Center z-coordinate

# Material configuration
# Uses built-in "InP - Palik" if available; falls back to "InP" or index 3.17
mat_name = "InP - Palik";
if (!materialexists(mat_name)) {
    if (materialexists("InP")) {
        mat_name = "InP";
    } else {
        mat_name = addmaterial("(n,k) Material");
        setmaterial(mat_name, "name", "InP");
        setmaterial("InP", "Refractive Index", 3.17);
        mat_name = "InP";
    }
}

# Toggle:
#   0 = Create 5 individual sections (left outer taper, left inner taper,
#       center waveguide, right inner taper, right outer taper) inside a
#       structure group (convenient for EME cells & object inspection)
#   1 = Create a single unified 12-vertex extruded polygon
use_single_polygon = 0;

# -------------------------------------------------------------------------
# 2. Key x-coordinates along propagation axis (centered at x = 0)
# -------------------------------------------------------------------------
x_left_tip  = -(L_center/2 + L_taper2 + L_taper1);  # -300 um
x_left_mid  = -(L_center/2 + L_taper2);             # -110 um
x_left_core = -(L_center/2);                        # -100 um
x_right_core =  (L_center/2);                       # +100 um
x_right_mid  =  (L_center/2 + L_taper2);            # +110 um
x_right_tip  =  (L_center/2 + L_taper2 + L_taper1); # +300 um

# -------------------------------------------------------------------------
# 3. Build 3D Geometry
# -------------------------------------------------------------------------
addstructuregroup;
set("name", "InP_Structure");
set("x", 0);
set("y", 0);
set("z", 0);

if (use_single_polygon == 1) {
    # Single continuous 12-vertex polygon in the x-y plane extruded in z
    V_all = [
        x_left_tip,   -w_tip/2;
        x_left_mid,   -w_mid/2;
        x_left_core,  -w_core/2;
        x_right_core, -w_core/2;
        x_right_mid,  -w_mid/2;
        x_right_tip,  -w_tip/2;
        x_right_tip,   w_tip/2;
        x_right_mid,   w_mid/2;
        x_right_core,  w_core/2;
        x_left_core,   w_core/2;
        x_left_mid,    w_mid/2;
        x_left_tip,    w_tip/2
    ];

    addpoly;
    set("name", "InP_waveguide_full");
    set("x", 0);
    set("y", 0);
    set("z", z_center);
    set("z span", t_z);
    set("vertices", V_all);
    set("material", mat_name);
    addtogroup("InP_Structure");

} else {
    # (1) Left Outer Taper: x from -300 um to -110 um, y-width 0.1 um -> 0.5 um
    V_left_outer = [
        x_left_tip, -w_tip/2;
        x_left_mid, -w_mid/2;
        x_left_mid,  w_mid/2;
        x_left_tip,  w_tip/2
    ];
    addpoly;
    set("name", "taper_left_outer_190um");
    set("x", 0);
    set("y", 0);
    set("z", z_center);
    set("z span", t_z);
    set("vertices", V_left_outer);
    set("material", mat_name);
    addtogroup("InP_Structure");

    # (2) Left Inner Taper: x from -110 um to -100 um, y-width 0.5 um -> 1.5 um
    V_left_inner = [
        x_left_mid,  -w_mid/2;
        x_left_core, -w_core/2;
        x_left_core,  w_core/2;
        x_left_mid,   w_mid/2
    ];
    addpoly;
    set("name", "taper_left_inner_10um");
    set("x", 0);
    set("y", 0);
    set("z", z_center);
    set("z span", t_z);
    set("vertices", V_left_inner);
    set("material", mat_name);
    addtogroup("InP_Structure");

    # (3) Central Straight Waveguide: x from -100 um to +100 um, y-width 1.5 um
    addrect;
    set("name", "core_center_200um");
    set("x", 0);
    set("x span", L_center);
    set("y", 0);
    set("y span", w_core);
    set("z", z_center);
    set("z span", t_z);
    set("material", mat_name);
    addtogroup("InP_Structure");

    # (4) Right Inner Taper: x from +100 um to +110 um, y-width 1.5 um -> 0.5 um
    V_right_inner = [
        x_right_core, -w_core/2;
        x_right_mid,  -w_mid/2;
        x_right_mid,   w_mid/2;
        x_right_core,  w_core/2
    ];
    addpoly;
    set("name", "taper_right_inner_10um");
    set("x", 0);
    set("y", 0);
    set("z", z_center);
    set("z span", t_z);
    set("vertices", V_right_inner);
    set("material", mat_name);
    addtogroup("InP_Structure");

    # (5) Right Outer Taper: x from +110 um to +300 um, y-width 0.5 um -> 0.1 um
    V_right_outer = [
        x_right_mid, -w_mid/2;
        x_right_tip, -w_tip/2;
        x_right_tip,  w_tip/2;
        x_right_mid,  w_mid/2
    ];
    addpoly;
    set("name", "taper_right_outer_190um");
    set("x", 0);
    set("y", 0);
    set("z", z_center);
    set("z span", t_z);
    set("vertices", V_right_outer);
    set("material", mat_name);
    addtogroup("InP_Structure");
}

?"3D InP structure successfully generated (Total x-length: " + num2str((x_right_tip - x_left_tip)/um) + " um, max y-width: " + num2str(w_core/um) + " um, z-thickness: " + num2str(t_z/nm) + " nm).";
